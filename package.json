{
  "name": "tenax",
  "productName": "Tenax",
  "description": "Tenax: a study app for long-term memory",
  "author": "UnoVex11223",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "dist": "vite build && electron-builder --win --publish never",
    "test": "node --test tests/*.test.js tests/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "d3-force": "^3.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.9",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "build": {
    "appId": "app.tenax.desktop",
    "productName": "Tenax",
    "files": [
      "dist/**",
      "build/**",
      "electron.cjs",
      "preload.cjs",
      "pdf-text.cjs",
      "sync-folder.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Tenax",
      "artifactName": "Tenax-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "UnoVex11223",
        "repo": "Study-Application",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UnoVex11223/Study-Application.git"
  }
}
